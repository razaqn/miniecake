# ==========================================
# MINIECAKE E-CATALOG CONFIGURATION
# ==========================================

# Identitas Aplikasi
APP_NAME="miniecake"
APP_TAGLINE="Sweet Moments in Every Bite"
APP_URL="http://localhost:8000"

# Autentikasi Admin Panel
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="password123"
ADMIN_SESSION_NAME="miniecake_admin_session"

# Kontak & Media Sosial (Akan tampil di website dan tombol sticky)
# Nomor WhatsApp wajib diawali kode negara tanpa tanda plus atau strip (contoh: 6281234567890)
WHATSAPP_NUMBER="6281234567890"
INSTAGRAM_URL="https://instagram.com/miniecake"
FACEBOOK_URL="https://facebook.com/miniecake"
TIKTOK_URL="https://tiktok.com/@miniecake"

# ==========================================
# GOOGLE DRIVE & SPREADSHEET API (TANPA SERVICE ACCOUNT)
# ==========================================
# Silakan isi token/kredensial OAuth 2.0 milik Anda sendiri di bawah ini.
# Biarkan kosong jika ingin menggunakan penyimpanan lokal sementara.

# 1. OAuth2 Credentials (Client ID & Client Secret dari Google Cloud Console)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# 2. Token Akses
# Anda bisa menggunakan Refresh Token (agar token tidak expired)
# ATAU Access Token langsung (dari OAuth2 Playground).
GOOGLE_REFRESH_TOKEN=""
GOOGLE_ACCESS_TOKEN=""

# 3. ID Spreadsheet (diambil dari URL Google Sheet: https://docs.google.com/spreadsheets/d/{SPREADSHEET_ID}/edit)
GOOGLE_SPREADSHEET_ID=""
GOOGLE_SPREADSHEET_SHEET_NAME="Products"

# 4. ID Folder Google Drive untuk menyimpan upload foto produk
# (diambil dari URL folder Google Drive: https://drive.google.com/drive/folders/{FOLDER_ID})
GOOGLE_DRIVE_FOLDER_ID=""

